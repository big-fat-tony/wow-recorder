{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WoW Recorder",
  "version": "0.1.0",
  "identifier": "dev.bigfattony.wow-recorder",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "WoW Recorder",
        "width": 760,
        "height": 880,
        "minWidth": 560,
        "minHeight": 520,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "libobs/": "libobs/"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlBOUVDRUUyMTQyNzM4QkQKUldTOU9DY1U0czZlbWxMVm5LL3paMVR3MG4rdTU1eGJ2V3YrWjJSWXVlSi81K0M4YlBTekNkYkYK",
      "endpoints": [
        "https://github.com/big-fat-tony/wow-recorder/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
